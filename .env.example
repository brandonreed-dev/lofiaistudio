# LoFi AI Studio - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server Configuration
PORT=3001

# Runtime Endpoints
# Ollama - Local LLM server for text generation
OLLAMA_ENDPOINT=http://localhost:11434

# ComfyUI - Stable Diffusion workflow engine for image/video generation
COMFYUI_ENDPOINT=http://localhost:8188

# Qwen3 Audio Wrapper - Speech-to-text and text-to-speech
QWEN3_AUDIO_ENDPOINT=http://localhost:8001

# A1111 WebUI - Alternative Stable Diffusion backend (optional)
A1111_ENDPOINT=http://localhost:7860

# Storage
# Config directory for database and settings (default: ~/.lofiaistudio)
LOFIAISTUDIO_CONFIG_DIR=

# Output directory for generated files (default: ~/.lofiaistudio/outputs)
LOFIAISTUDIO_OUTPUT_DIR=